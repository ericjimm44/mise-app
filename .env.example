# Copy to .env.local — which is gitignored and must STAY gitignored.
#
# This is a local-first app with no backend, so the key is used from the
# browser. That is a deliberate, recorded trade-off for a personal tool
# (see docs/decisions.md §3) and is NOT acceptable if this is ever published
# for other people to use — at that point generation moves behind a server.
#
# Never commit a real key. A key committed once lives in git history forever,
# even after it is deleted in a later commit.

VITE_ANTHROPIC_API_KEY=sk-ant-replace-me
